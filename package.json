{
  "name": "etour",
  "version": "1.0.0",
  "description": "Tur operatorları və otellər üçün qiymət müqayisə platforması (B2C + B2B)",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:db": "node --test test/db.test.js",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.spec.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "create-agency": "node scripts/create-agency.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "audit": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrhuseyin777-ops/Turizm-Sayti---online-.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/mrhuseyin777-ops/Turizm-Sayti---online-/issues"
  },
  "homepage": "https://github.com/mrhuseyin777-ops/Turizm-Sayti---online-#readme",
  "dependencies": {
    "@sentry/node": "11.16.0",
    "express": "4.22.3",
    "pg": "8.16.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
